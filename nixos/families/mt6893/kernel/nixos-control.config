# SPDX-License-Identifier: GPL-2.0-only

# Required to populate /dev during a normal Linux stage 1.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Required by current systemd and container-oriented userspace.
CONFIG_FHANDLE=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y

# Required by the classic ARM64 kexec path in this 4.19 vendor kernel.
CONFIG_KEXEC=y
