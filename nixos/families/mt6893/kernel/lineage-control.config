# SPDX-License-Identifier: GPL-2.0-only

# Keep the Android bootstrap kernel ABI as close as possible to the exact
# pinned .3001 kernel. This fragment is merged into that kernel's embedded
# effective config, not into OnePlus's older published defconfig.
CONFIG_KEXEC=y

# The exact stock MediaTek modules carry `4.19.191+` in their vermagic.
CONFIG_LOCALVERSION="+"

# The pinned stock kernel did not build a compat vDSO. The newer Lineage
# toolchain otherwise enables it by default when its compat compiler exists.
# CONFIG_COMPAT_VDSO is not set
