#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: nord2t-compare-kernel-module-payloads VENDOR_IMAGE MODULE_DIRECTORY

Compare the exact eight source-built Karen connectivity modules with their
counterparts in the pinned stock-derived vendor image. Appended Linux module
signatures are excluded from both sides before hashing and byte comparison.

Payload differences are reported, not treated as failure: a different compiler
or source revision can change the ELF bytes while retaining the same module ABI.
The module name, vermagic, versioned imports and exports are compared separately.
EOF
}

fail() {
  echo "Karen kernel module payload comparison failed: $*" >&2
  exit 1
}

if (( $# != 2 )); then
  usage
  exit 2
fi

vendor_image="$(realpath "$1")"
module_directory="$(realpath "$2")"
partition_manifest="${PARTITION_MANIFEST:-@PARTITION_MANIFEST@}"

[[ -s "$vendor_image" ]] ||
  fail "vendor image is not readable: $vendor_image"
[[ -d "$module_directory" ]] ||
  fail "module directory is not readable: $module_directory"
[[ -r "$partition_manifest" ]] ||
  fail "partition manifest is not readable: $partition_manifest"

expected_vendor_size="$(
  jq -er '.partitions[] | select(.name == "vendor") | .size' \
    "$partition_manifest"
)"
expected_vendor_hash="$(
  jq -er '.partitions[] | select(.name == "vendor") | .sha256' \
    "$partition_manifest"
)"
actual_vendor_size="$(stat -c %s "$vendor_image")"
actual_vendor_hash="$(sha256sum "$vendor_image" | cut -d ' ' -f 1)"
[[ "$actual_vendor_size" == "$expected_vendor_size" ]] ||
  fail "vendor image is $actual_vendor_size bytes, expected $expected_vendor_size"
[[ "$actual_vendor_hash" == "$expected_vendor_hash" ]] ||
  fail "vendor image does not match the exact pinned stock-derived image"

modules=(
  bt_drv_6893.ko
  connfem.ko
  conninfra.ko
  fmradio_drv_connac2x.ko
  gps_drv.ko
  trace_mmstat.ko
  wlan_drv_gen4m.ko
  wmt_chrdev_wifi.ko
)

cache_root="${XDG_CACHE_HOME:-$HOME/.cache}"
comparison_temp_root="$cache_root/nord2t-recovery/module-comparison-tmp"
mkdir -p "$comparison_temp_root"
chmod 0700 "$comparison_temp_root"
temporary_directory="$(
  mktemp -d --tmpdir="$comparison_temp_root" nord2t-module-compare.XXXXXXXX
)"
chmod 0700 "$temporary_directory"
cleanup() {
  rm -rf -- "$temporary_directory"
}
trap cleanup EXIT
export TMPDIR="$temporary_directory"

expected_modules="$temporary_directory/expected-modules.txt"
actual_modules="$temporary_directory/actual-modules.txt"
printf '%s\n' "${modules[@]}" | sort -u >"$expected_modules"
find \
  "$module_directory" \
  -mindepth 1 \
  -maxdepth 1 \
  -type f \
  -name '*.ko' \
  -printf '%f\n' |
  sort -u >"$actual_modules"
cmp -s "$expected_modules" "$actual_modules" ||
  fail "module directory does not contain the exact eight-module set"

extract_payload() {
  local input="$1"
  local output="$2"
  local state_output="$3"
  local input_size
  local payload_size
  local signature_length
  local signer_length
  local key_id_length
  local -a signature_header

  if ! tail -c 28 "$input" |
    cmp -s - <(printf '%s\n' '~Module signature appended~'); then
    cp -- "$input" "$output"
    printf 'unsigned\n' >"$state_output"
    return
  fi

  read -r -a signature_header <<<"$(
    tail -c 40 "$input" |
      head -c 12 |
      od -An -v -t u1
  )"
  [[ "${#signature_header[@]}" -eq 12 ]] ||
    fail "$(basename "$input") has a malformed module signature header"
  [[ "${signature_header[2]}" -eq 2 ]] ||
    fail "$(basename "$input") does not use a PKCS#7 module signature"
  [[
    "${signature_header[5]}" -eq 0 &&
      "${signature_header[6]}" -eq 0 &&
      "${signature_header[7]}" -eq 0
  ]] || fail "$(basename "$input") has non-zero module signature padding"

  signer_length="${signature_header[3]}"
  key_id_length="${signature_header[4]}"
  signature_length=$((
    signature_header[8] * 16777216 +
      signature_header[9] * 65536 +
      signature_header[10] * 256 +
      signature_header[11]
  ))
  input_size="$(stat -c %s "$input")"
  payload_size=$((
    input_size -
      40 -
      signer_length -
      key_id_length -
      signature_length
  ))
  ((signature_length > 0 && payload_size > 0)) ||
    fail "$(basename "$input") has an invalid module signature length"

  head -c "$payload_size" "$input" >"$output"
  printf 'signed\n' >"$state_output"
}

canonical_modversions() {
  local mode="$1"
  local module="$2"
  local output="$3"

  if ! modprobe "$mode" "$module" >"$output" 2>/dev/null; then
    # kmod reports ENODATA for a valid module with no imports or exports.
    : >"$output"
  fi
  sort -u -o "$output" "$output"
}

payload_matches=0
abi_surface_matches=0

for module in "${modules[@]}"; do
  stock_module="$temporary_directory/stock-$module"
  candidate_module="$module_directory/$module"
  # kmod recognizes an explicit path as a module file only when its basename
  # retains the conventional .ko suffix.
  stock_payload="$temporary_directory/stock-payload-$module"
  candidate_payload="$temporary_directory/candidate-payload-$module"
  stock_state="$temporary_directory/stock-$module.state"
  candidate_state="$temporary_directory/candidate-$module.state"

  [[ -s "$candidate_module" ]] ||
    fail "candidate module is missing or empty: $module"
  dump.erofs \
    --cat \
    --path="/lib/modules/$module" \
    "$vendor_image" \
    >"$stock_module" 2>/dev/null ||
    fail "exact vendor is missing lib/modules/$module"
  [[ -s "$stock_module" ]] ||
    fail "exact vendor module is empty: $module"

  extract_payload "$stock_module" "$stock_payload" "$stock_state"
  extract_payload \
    "$candidate_module" \
    "$candidate_payload" \
    "$candidate_state"

  stock_name="$(modinfo -F name "$stock_payload")" ||
    fail "could not read the stock module name from $module"
  candidate_name="$(modinfo -F name "$candidate_payload")" ||
    fail "could not read the candidate module name from $module"
  stock_vermagic="$(modinfo -F vermagic "$stock_payload")" ||
    fail "could not read stock vermagic from $module"
  candidate_vermagic="$(modinfo -F vermagic "$candidate_payload")" ||
    fail "could not read candidate vermagic from $module"

  stock_imports="$temporary_directory/stock-$module.imports"
  candidate_imports="$temporary_directory/candidate-$module.imports"
  stock_exports="$temporary_directory/stock-$module.exports"
  candidate_exports="$temporary_directory/candidate-$module.exports"
  canonical_modversions --show-modversions "$stock_payload" "$stock_imports"
  canonical_modversions \
    --show-modversions \
    "$candidate_payload" \
    "$candidate_imports"
  canonical_modversions --show-exports "$stock_payload" "$stock_exports"
  canonical_modversions \
    --show-exports \
    "$candidate_payload" \
    "$candidate_exports"

  payload_equal=no
  name_equal=no
  vermagic_equal=no
  imports_equal=no
  exports_equal=no
  if cmp -s "$stock_payload" "$candidate_payload"; then
    payload_equal=yes
    ((payload_matches += 1))
  fi
  if [[ "$stock_name" == "$candidate_name" ]]; then
    name_equal=yes
  fi
  if [[ "$stock_vermagic" == "$candidate_vermagic" ]]; then
    vermagic_equal=yes
  fi
  if cmp -s "$stock_imports" "$candidate_imports"; then
    imports_equal=yes
  fi
  if cmp -s "$stock_exports" "$candidate_exports"; then
    exports_equal=yes
  fi
  if [[
    "$name_equal" == yes &&
      "$vermagic_equal" == yes &&
      "$imports_equal" == yes &&
      "$exports_equal" == yes
  ]]; then
    ((abi_surface_matches += 1))
  fi

  printf \
    'module=%s stock_signing=%s candidate_signing=%s payload_equal=%s name_equal=%s vermagic_equal=%s imports_equal=%s exports_equal=%s stock_payload_bytes=%s candidate_payload_bytes=%s stock_payload_sha256=%s candidate_payload_sha256=%s\n' \
    "$module" \
    "$(<"$stock_state")" \
    "$(<"$candidate_state")" \
    "$payload_equal" \
    "$name_equal" \
    "$vermagic_equal" \
    "$imports_equal" \
    "$exports_equal" \
    "$(stat -c %s "$stock_payload")" \
    "$(stat -c %s "$candidate_payload")" \
    "$(sha256sum "$stock_payload" | cut -d ' ' -f 1)" \
    "$(sha256sum "$candidate_payload" | cut -d ' ' -f 1)"
done

printf 'payload_matches=%d/%d\n' "$payload_matches" "${#modules[@]}"
printf \
  'module_abi_surface_matches=%d/%d\n' \
  "$abi_surface_matches" \
  "${#modules[@]}"
echo "Karen kernel module payload comparison completed."
