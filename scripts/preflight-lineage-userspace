#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: nord2t-preflight-lineage-userspace LINEAGE_DIR STOCK_RESTORE_DIR
                                           [--allow-stale-cow]

Validate a complete Lineage image bundle, the scoped .3001 rollback bundle,
and the connected CPH2399 dynamic-partition layout. The phone may be running
the exact rooted .3001 baseline or the audited Lineage Recovery. This command
is read-only: it never reboots, flashes, erases, formats or wipes the phone.
EOF
}

fail() {
  echo "Lineage userspace preflight failed: $*" >&2
  exit 1
}

if [[ $# -lt 2 || $# -gt 3 ]]; then
  usage
  exit 2
fi

lineage_directory="$(realpath "$1")"
restore_directory="$(realpath "$2")"
allow_stale_cow=false
if [[ $# -eq 3 ]]; then
  [[ "$3" == --allow-stale-cow ]] || {
    usage
    exit 2
  }
  allow_stale_cow=true
fi
partition_manifest="${PARTITION_MANIFEST:-@PARTITION_MANIFEST@}"

[[ -d "$lineage_directory" ]] ||
  fail "Lineage image directory is not readable"
[[ -d "$restore_directory" ]] ||
  fail "stock restore directory is not readable"
[[ -r "$partition_manifest" ]] ||
  fail "partition manifest is not readable"

temporary_directory="$(mktemp -d -t nord2t-lineage-preflight.XXXXXXXX)"
cleanup() {
  rm -rf -- "$temporary_directory"
}
trap cleanup EXIT

lineage_audit="$temporary_directory/lineage-audit.txt"
nord2t-audit-lineage-images "$lineage_directory" >"$lineage_audit" ||
  fail "Lineage image bundle did not pass its structural audit"

restore_images=(
  boot
  dtbo
  system
  system_ext
  product
  vendor
  odm
  vbmeta
  vbmeta_system
  vbmeta_vendor
)

mapfile -t manifest_restore_images < <(
  jq -er '.profiles.restore[]' "$partition_manifest"
)
[[ "${restore_images[*]}" == "${manifest_restore_images[*]}" ]] ||
  fail "restore profile does not contain the expected scoped partition set"

for partition in "${restore_images[@]}"; do
  image="$restore_directory/images/$partition.img"
  [[ -f "$image" && -r "$image" && -s "$image" ]] ||
    fail "stock restore image is missing: $partition.img"

  expected_size="$(
    jq -er --arg name "$partition" \
      '.partitions[] | select(.name == $name) | .size' \
      "$partition_manifest"
  )"
  expected_hash="$(
    jq -er --arg name "$partition" \
      '.partitions[] | select(.name == $name) | .sha256' \
      "$partition_manifest"
  )"
  [[ "$(stat -c %s "$image")" == "$expected_size" ]] ||
    fail "stock restore size is wrong: $partition.img"
  [[ "$(sha256sum "$image" | cut -d ' ' -f 1)" == "$expected_hash" ]] ||
    fail "stock restore hash is wrong: $partition.img"
done

if [[ -r "$restore_directory/SOURCE.json" ]]; then
  jq -e \
    --argjson expected "$(printf '%s\n' "${restore_images[@]}" | jq -R . | jq -s .)" \
    '.profile == "restore" and .partitions == $expected' \
    "$restore_directory/SOURCE.json" >/dev/null ||
    fail "stock restore provenance is not the expected profile"
fi

mapfile -t adb_device_rows < <(
  adb devices |
    awk 'NR > 1 && ($2 == "device" || $2 == "recovery") { print $1 " " $2 }'
)
[[ "${#adb_device_rows[@]}" -eq 1 ]] ||
  fail "expected exactly one authorized stock Android or recovery ADB device"
read -r serial adb_state <<<"${adb_device_rows[0]}"

adb_property() {
  adb -s "$serial" shell getprop "$1" 2>/dev/null | tr -d '\r'
}

lpdump_json="$temporary_directory/lpdump.json"
preflight_source=
stale_cow_cleanup_required=false

if [[ "$adb_state" == device ]]; then
  [[ "$(adb_property sys.boot_completed)" == 1 ]] ||
    fail "Android has not finished booting"
  [[ "$(adb_property ro.product.model)" == CPH2399 ]] ||
    fail "connected model is not CPH2399"
  [[ "$(adb_property ro.product.device)" == OP557AL1 ]] ||
    fail "connected device is not OP557AL1"
  [[ "$(adb_property ro.build.display.id)" == "CPH2399_14.0.0.3001(EX01)" ]] ||
    fail "installed system is not the pinned .3001 stock baseline"
  [[ "$(adb_property ro.boot.slot_suffix)" == _a ]] ||
    fail "the populated and audited slot A is not active"
  [[ "$(adb_property ro.boot.dynamic_partitions)" == true ]] ||
    fail "dynamic partitions are not enabled"
  [[ "$(adb_property ro.virtual_ab.enabled)" == true ]] ||
    fail "virtual A/B is not enabled"
  [[ "$(adb_property ro.boot.flash.locked)" == 0 ]] ||
    fail "bootloader is not unlocked"
  [[ "$(adb_property ro.boot.vbmeta.device_state)" != locked ]] ||
    fail "verified boot still reports a locked device"
  [[ "$(adb -s "$serial" exec-out su -c id -u 2>/dev/null | tr -d '\r')" == 0 ]] ||
    fail "approved read-only root is unavailable"

  adb -s "$serial" exec-out su -c 'lpdump --slot 0 --json' \
    >"$lpdump_json" 2>/dev/null ||
    fail "could not read slot-0 logical metadata"
  preflight_source=stock-android
else
  [[ "$(adb_property ro.bootmode)" == recovery ]] ||
    fail "ADB recovery state does not report recovery boot mode"
  [[ "$(adb_property ro.product.model)" == CPH2399 ]] ||
    fail "connected recovery model is not CPH2399"
  [[ "$(adb_property ro.product.device)" == karen ]] ||
    fail "connected recovery device is not Karen"
  [[ "$(adb_property ro.lineage.version)" == 21.0-*-UNOFFICIAL-karen ]] ||
    fail "connected recovery is not the audited private Lineage 21 target"
  [[ "$(adb_property ro.boot.slot_suffix)" == _a ]] ||
    fail "the populated and audited slot A is not active"
  [[ "$(adb_property ro.boot.verifiedbootstate)" == orange ]] ||
    fail "recovery does not report the expected unlocked verified-boot state"
  [[ "$(adb_property ro.boot.dynamic_partitions)" == true ]] ||
    fail "dynamic partitions are not enabled"
  [[ "$(adb_property ro.virtual_ab.enabled)" == true ]] ||
    fail "virtual A/B is not enabled"
  [[ "$(adb -s "$serial" exec-out id -u 2>/dev/null | tr -d '\r')" == 0 ]] ||
    fail "recovery ADB is not root"
  adb -s "$serial" shell \
    'test -b /dev/block/by-name/super' >/dev/null 2>&1 ||
    fail "recovery cannot access the generic super block device"

  super_metadata="$temporary_directory/super-metadata.img"
  raw_lpdump_json="$temporary_directory/lpdump-raw.json"
  adb -s "$serial" exec-out \
    'dd if=/dev/block/by-name/super bs=1048576 count=4 2>/dev/null' \
    >"$super_metadata" ||
    fail "could not read the bounded super metadata prefix"
  [[ "$(stat -c %s "$super_metadata")" == 4194304 ]] ||
    fail "recovery returned an incomplete super metadata prefix"
  lpdump --slot=0 --json "$super_metadata" >"$raw_lpdump_json" 2>/dev/null ||
    fail "host lpdump could not parse slot-0 super metadata"
  jq empty "$raw_lpdump_json" ||
    fail "host lpdump did not return valid JSON"

  jq -e '
    (.block_devices | length) == 1 and
    .block_devices[0].name == "super" and
    (.block_devices[0].size | tonumber) == 12348030976 and
    ([.groups[] | select(
      .name == "main_a" and
      (.maximum_size | tonumber) == 12343836672
    )] | length) == 1
  ' "$raw_lpdump_json" >/dev/null ||
    fail "raw super metadata does not contain the audited slot-A group"

  cow_partitions_json="$(
    jq -c '
      [
        .partitions[] |
        select((.name | endswith("-cow")) or .group_name == "cow") |
        {name, size: (.size | tonumber), group_name, is_dynamic}
      ] |
      sort_by(.name)
    ' "$raw_lpdump_json"
  )"
  if [[ "$cow_partitions_json" != '[]' ]]; then
    [[ "$allow_stale_cow" == true ]] ||
      fail "raw super metadata contains an active or stale COW snapshot layout"
    expected_cow_partitions_json='[
      {"name":"my_engineering_a-cow","size":344064,"group_name":"cow","is_dynamic":true},
      {"name":"my_heytap_a-cow","size":15728640,"group_name":"cow","is_dynamic":true},
      {"name":"my_product_a-cow","size":415473664,"group_name":"cow","is_dynamic":true},
      {"name":"my_stock_a-cow","size":1269821440,"group_name":"cow","is_dynamic":true},
      {"name":"odm_a-cow","size":1123184640,"group_name":"cow","is_dynamic":true},
      {"name":"product_a-cow","size":2146304,"group_name":"cow","is_dynamic":true},
      {"name":"system_a-cow","size":819269632,"group_name":"cow","is_dynamic":true},
      {"name":"system_ext_a-cow","size":1129414656,"group_name":"cow","is_dynamic":true},
      {"name":"vendor_a-cow","size":489263104,"group_name":"cow","is_dynamic":true}
    ]'
    jq -en \
      --argjson actual "$cow_partitions_json" \
      --argjson expected "$expected_cow_partitions_json" \
      '$actual == $expected' >/dev/null ||
      fail "COW snapshot layout is not the single audited stale set"
    stale_cow_cleanup_required=true
  fi

  jq '
    {
      enabled: true,
      block_devices,
      groups: [
        .groups[] |
        select(.name == "main_a") |
        .name = "main"
      ],
      partitions: [
        .partitions[] |
        select(.group_name == "main_a") |
        .name |= sub("_a$"; "") |
        .group_name = "main"
      ]
    }
  ' "$raw_lpdump_json" >"$lpdump_json"
  preflight_source=lineage-recovery
fi

jq empty "$lpdump_json" ||
  fail "lpdump did not return valid JSON"

standard_names_json='["odm","product","system","system_ext","vendor"]'
oplus_names_json='["my_bigball","my_carrier","my_company","my_engineering","my_heytap","my_manifest","my_preload","my_product","my_region","my_stock"]'
all_names_json="$(
  jq -cn \
    --argjson standard "$standard_names_json" \
    --argjson oplus "$oplus_names_json" \
    '$standard + $oplus | sort'
)"

jq -e \
  --argjson names "$all_names_json" \
  '
    .enabled == true and
    (.block_devices | length) == 1 and
    .block_devices[0].name == "super" and
    (.block_devices[0].size | tonumber) == 12348030976 and
    (.groups | length) == 1 and
    .groups[0].name == "main" and
    (.groups[0].maximum_size | tonumber) == 12343836672 and
    (.partitions | length) == 15 and
    ([.partitions[].name] | sort) == $names and
    all(.partitions[]; .is_dynamic == true and .group_name == "main")
  ' "$lpdump_json" >/dev/null ||
  fail "live super metadata no longer matches the audited Karen layout"

standard_live_bytes="$(
  jq -er \
    --argjson names "$standard_names_json" \
    '[.partitions[] | select(.name as $name | $names | index($name)) | .size | tonumber] | add' \
    "$lpdump_json"
)"
oplus_live_bytes="$(
  jq -er \
    --argjson names "$oplus_names_json" \
    '[.partitions[] | select(.name as $name | $names | index($name)) | .size | tonumber] | add' \
    "$lpdump_json"
)"
group_live_bytes="$(
  jq -er '[.partitions[].size | tonumber] | add' "$lpdump_json"
)"

[[ "$standard_live_bytes" == 3549384704 ]] ||
  fail "live standard allocation changed from the audited stock baseline"
[[ "$oplus_live_bytes" == 3527249920 ]] ||
  fail "live OPlus allocation changed from the audited stock baseline"
[[ "$group_live_bytes" == 7076634624 ]] ||
  fail "live main-group allocation changed from the audited stock baseline"

standard_image_ceiling=$((12343836672 - oplus_live_bytes))
[[ "$standard_image_ceiling" == 8816586752 ]] ||
  fail "preserved standard-image budget is not the audited value"

lineage_standard_bytes="$(
  sed -n 's/^standard_image_bytes=//p' "$lineage_audit" | tail -n 1
)"
[[ "$lineage_standard_bytes" =~ ^[0-9]+$ ]] ||
  fail "Lineage audit did not report its standard-image allocation"
((lineage_standard_bytes <= standard_image_ceiling)) ||
  fail "Lineage images do not fit while preserving every OPlus partition"

echo "Karen full-userspace preflight passed."
echo "active_slot=a"
echo "super_bytes=12348030976"
echo "main_group_bytes=12343836672"
echo "live_standard_bytes=$standard_live_bytes"
echo "live_oplus_bytes=$oplus_live_bytes"
echo "lineage_standard_bytes=$lineage_standard_bytes"
echo "standard_image_ceiling=$standard_image_ceiling"
echo "restore_images=exact"
echo "preflight_source=$preflight_source"
echo "stale_cow_cleanup_required=$stale_cow_cleanup_required"
echo "flash_gate=explicit-destructive-test-still-required"
