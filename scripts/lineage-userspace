#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  nord2t-lineage-userspace install LINEAGE_DIR STOCK_RESTORE_DIR
                                    [--cleanup-stale-cow]
                                    [--stay-bootloader] [--yes]
  nord2t-lineage-userspace restore STOCK_RESTORE_DIR [--yes]

Install first stages the exact stock boot/AVB chain so the tested stock
fastbootd exposes slot-A logical mappings. It then writes only system,
system_ext, product, boot_a and the three slot-A AVB metadata partitions
after the complete stock/live preflight passes. Vendor, odm, dtbo and all
OPlus logical partitions remain untouched.

Restore writes the five exact stock logical images and the exact stock boot_a
and AVB metadata. It can start from authorized ADB, fastbootd or
bootloader-fastboot. --yes skips only the interactive destructive-write
confirmation. --stay-bootloader is install-only and leaves the audited
Lineage bootloader-fastboot endpoint ready for a separately audited private
boot pair or an explicit recovery boot.

--cleanup-stale-cow is install-only. It accepts only the single audited set of
nine stock OTA COW partitions, requires stock fastbootd to report snapshot
status "none", and deletes those temporary logical partitions before writing
Lineage. It never issues snapshot-update cancel.
EOF
}

fail() {
  echo "Lineage userspace operation failed: $*" >&2
  if [[ "${write_started:-false}" == true ]]; then
    echo "A partition write was interrupted." >&2
    echo "Keep the phone in its current USB mode and run the restore action." >&2
  fi
  exit 1
}

if [[ $# -eq 1 && ("$1" == -h || "$1" == --help) ]]; then
  usage
  exit 0
fi

[[ $# -ge 2 ]] || {
  usage
  exit 2
}

action="$1"
shift
assume_yes=false
stay_bootloader=false
cleanup_stale_cow=false

case "$action" in
  install)
    [[ $# -ge 2 ]] || {
      usage
      exit 2
    }
    lineage_directory="$(realpath "$1")"
    restore_directory="$(realpath "$2")"
    shift 2
    ;;
  restore)
    restore_directory="$(realpath "$1")"
    shift
    ;;
  *)
    usage
    exit 2
    ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes)
      assume_yes=true
      shift
      ;;
    --stay-bootloader)
      stay_bootloader=true
      shift
      ;;
    --cleanup-stale-cow)
      cleanup_stale_cow=true
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ "$action" != install && "$stay_bootloader" == true ]]; then
  fail "--stay-bootloader is valid only for install"
fi
if [[ "$action" != install && "$cleanup_stale_cow" == true ]]; then
  fail "--cleanup-stale-cow is valid only for install"
fi

partition_manifest="${PARTITION_MANIFEST:-@PARTITION_MANIFEST@}"
[[ -r "$partition_manifest" ]] ||
  fail "partition manifest is not readable"
[[ -d "$restore_directory" ]] ||
  fail "stock restore directory is not readable"

restore_images=(
  boot
  dtbo
  system
  system_ext
  product
  vendor
  odm
  vbmeta
  vbmeta_system
  vbmeta_vendor
)

verify_restore_bundle() {
  local partition image expected_size expected_hash

  for partition in "${restore_images[@]}"; do
    image="$restore_directory/images/$partition.img"
    [[ -f "$image" && -r "$image" && -s "$image" ]] ||
      fail "stock restore image is missing: $partition.img"
    expected_size="$(
      jq -er --arg name "$partition" \
        '.partitions[] | select(.name == $name) | .size' \
        "$partition_manifest"
    )"
    expected_hash="$(
      jq -er --arg name "$partition" \
        '.partitions[] | select(.name == $name) | .sha256' \
        "$partition_manifest"
    )"
    [[ "$(stat -c %s "$image")" == "$expected_size" ]] ||
      fail "stock restore size is wrong: $partition.img"
    [[ "$(sha256sum "$image" | cut -d ' ' -f 1)" == "$expected_hash" ]] ||
      fail "stock restore hash is wrong: $partition.img"
  done
}

if [[ "$action" == install ]]; then
  [[ -d "$lineage_directory" ]] ||
    fail "Lineage image directory is not readable"
  preflight_arguments=(
    "$lineage_directory"
    "$restore_directory"
  )
  if [[ "$cleanup_stale_cow" == true ]]; then
    preflight_arguments+=(--allow-stale-cow)
  fi
  nord2t-preflight-lineage-userspace "${preflight_arguments[@]}"
else
  verify_restore_bundle
fi

if [[ "$assume_yes" != true ]]; then
  if [[ "$action" == install ]]; then
    if [[ "$cleanup_stale_cow" == true ]]; then
      printf 'Delete the audited stale COW set and write Lineage to slot A? Type CPH2399: ' >&2
    else
      printf 'Write the audited Lineage userspace to slot A? Type CPH2399: ' >&2
    fi
  else
    printf 'Restore exact .3001 userspace and boot to slot A? Type CPH2399: ' >&2
  fi
  read -r confirmation
  [[ "$confirmation" == CPH2399 ]] || fail "confirmation declined"
fi

temporary_directory="$(mktemp -d -t nord2t-lineage-write.XXXXXXXX)"
cleanup() {
  rm -rf -- "$temporary_directory"
}
trap cleanup EXIT

redact_fastboot_output() {
  sed "s/${fastboot_serial//\//\\/}/<device>/g" "$1"
}

run_fastboot() {
  local output="$temporary_directory/fastboot-output.txt"

  if fastboot -s "$fastboot_serial" "$@" >"$output" 2>&1; then
    redact_fastboot_output "$output"
    return 0
  fi
  redact_fastboot_output "$output" >&2
  return 1
}

fastboot_variable() {
  local variable="$1"
  local output="$temporary_directory/getvar-output.txt"

  fastboot -s "$fastboot_serial" getvar "$variable" >"$output" 2>&1 ||
    return 1
  sed -nE "s/.*${variable}: ([^[:space:]]+).*/\\1/p" "$output" |
    head -n 1
}

select_adb_device() {
  mapfile -t adb_devices < <(
    adb devices |
      awk 'NR > 1 && ($2 == "device" || $2 == "recovery") { print $1 }'
  )
  [[ "${#adb_devices[@]}" -eq 1 ]] || return 1
  adb_serial="${adb_devices[0]}"
}

select_fastboot_mode() {
  local expected_mode="$1"

  mapfile -t fastboot_devices < <(
    fastboot devices |
      awk -v mode="$expected_mode" '$2 == mode { print $1 }'
  )
  [[ "${#fastboot_devices[@]}" -eq 1 ]] || return 1
  fastboot_serial="${fastboot_devices[0]}"
}

wait_for_fastboot_mode() {
  local expected_mode="$1"

  for _ in $(seq 1 60); do
    if select_fastboot_mode "$expected_mode"; then
      return 0
    fi
    sleep 1
  done
  return 1
}

verify_bootloader_identity() {
  [[ "$(fastboot_variable is-userspace)" == no ]] ||
    fail "device is not in bootloader-fastboot"
  [[ "$(fastboot_variable unlocked)" == yes ]] ||
    fail "bootloader is not unlocked"
  [[ "$(fastboot_variable product)" == k6893v1_64_k419 ]] ||
    fail "bootloader product is not the tested Karen platform"
  [[ "$(fastboot_variable hw-revision)" == ca00 ]] ||
    fail "bootloader hardware revision is not the tested CPH2399 revision"
}

ensure_bootloader_slot_a() {
  local current_slot

  current_slot="$(fastboot_variable current-slot)"
  [[ "$current_slot" == a || "$current_slot" == b ]] ||
    fail "bootloader reported an unexpected active slot"
  if [[ "$current_slot" == b ]]; then
    run_fastboot set_active a
  fi
  [[ "$(fastboot_variable current-slot)" == a ]] ||
    fail "could not make slot A active"
}

fastbootd_slot_a_verified=false
fastbootd_requires_explicit_slot=false

verify_fastbootd() {
  local current_slot logical_system logical_system_a

  [[ "$(fastboot_variable is-userspace)" == yes ]] ||
    fail "device is not in fastbootd"
  current_slot="$(fastboot_variable current-slot)"
  [[ "$current_slot" == a ||
    (-z "$current_slot" && "$fastbootd_slot_a_verified" == true) ]] ||
    fail "slot A is not active in fastbootd"
  if [[ -z "$current_slot" ]]; then
    :
  elif [[ "$current_slot" != a ]]; then
    fail "slot A is not active in fastbootd"
  fi

  logical_system="$(fastboot_variable is-logical:system || true)"
  logical_system_a="$(fastboot_variable is-logical:system_a || true)"
  if [[ "$logical_system" == yes ]]; then
    fastbootd_requires_explicit_slot=false
  elif [[ "$logical_system_a" == yes ]]; then
    fastbootd_requires_explicit_slot=true
  else
    fail "fastbootd exposed no writable slot-A system mapping"
  fi
}

fastbootd_partition_name() {
  local partition="$1"

  if [[ "$fastbootd_requires_explicit_slot" == true ]]; then
    echo "${partition}_a"
  else
    echo "$partition"
  fi
}

reboot_bootloader_to_fastbootd() {
  local output="$temporary_directory/reboot-fastboot-output.txt"

  [[ "$(fastboot_variable is-userspace)" == no ]] ||
    fail "cannot attest the active slot outside bootloader-fastboot"
  [[ "$(fastboot_variable current-slot)" == a ]] ||
    fail "slot A was not active before entering fastbootd"
  fastbootd_slot_a_verified=true

  timeout 20 fastboot -s "$fastboot_serial" reboot fastboot \
    >"$output" 2>&1 || true
  redact_fastboot_output "$output"
  wait_for_fastboot_mode fastbootd ||
    fail "fastbootd did not enumerate after the mode transition"
  verify_fastbootd
}

reboot_fastbootd_to_bootloader() {
  run_fastboot reboot bootloader
  wait_for_fastboot_mode fastboot ||
    fail "bootloader-fastboot did not enumerate after the mode transition"
  verify_bootloader_identity
  ensure_bootloader_slot_a
}

enter_bootloader_from_adb() {
  select_adb_device || return 1
  adb -s "$adb_serial" reboot bootloader >/dev/null 2>&1 ||
    fail "ADB could not request bootloader-fastboot"
  wait_for_fastboot_mode fastboot ||
    fail "bootloader-fastboot did not enumerate"
  verify_bootloader_identity
  ensure_bootloader_slot_a
}

ensure_bootloader() {
  if select_fastboot_mode fastbootd; then
    reboot_fastbootd_to_bootloader
    return
  fi
  if select_fastboot_mode fastboot; then
    verify_bootloader_identity
    ensure_bootloader_slot_a
    return
  fi
  if enter_bootloader_from_adb; then
    return
  fi
  fail "expected one authorized ADB, fastbootd or bootloader-fastboot device"
}

flash_partition() {
  local expected_mode="$1"
  local partition="$2"
  local image="$3"
  local attempt

  for attempt in 1 2; do
    if run_fastboot flash "$partition" "$image"; then
      return 0
    fi

    [[ "$attempt" -lt 2 ]] || return 1
    echo "Fastboot transfer failed; waiting for a stable $expected_mode retry." >&2
    wait_for_fastboot_mode "$expected_mode" ||
      fail "$expected_mode did not re-enumerate for the bounded retry"
    sleep 5

    if [[ "$expected_mode" == fastbootd ]]; then
      verify_fastbootd
    else
      verify_bootloader_identity
      ensure_bootloader_slot_a
    fi
  done
}

stage_stock_fastbootd_boot_chain() {
  local partition

  for partition in vbmeta_system vbmeta_vendor vbmeta; do
    flash_partition \
      fastboot \
      "${partition}_a" \
      "$restore_directory/images/$partition.img"
  done
  flash_partition fastboot boot_a "$restore_directory/images/boot.img"
}

cleanup_audited_stale_cow_partitions() {
  local partition specification expected_size reported_size
  local specifications=(
    my_engineering_a-cow:344064
    my_heytap_a-cow:15728640
    my_product_a-cow:415473664
    my_stock_a-cow:1269821440
    odm_a-cow:1123184640
    product_a-cow:2146304
    system_a-cow:819269632
    system_ext_a-cow:1129414656
    vendor_a-cow:489263104
  )

  [[ "$(fastboot_variable snapshot-update-status)" == none ]] ||
    fail "stock fastbootd does not report snapshot-update-status none"

  for specification in "${specifications[@]}"; do
    partition="${specification%%:*}"
    expected_size="${specification#*:}"
    [[ "$(fastboot_variable "is-logical:$partition")" == yes ]] ||
      fail "audited stale COW partition is missing: $partition"
    reported_size="$(fastboot_variable "partition-size:$partition")"
    [[ "$reported_size" =~ ^(0[xX][0-9a-fA-F]+|[0-9]+)$ ]] ||
      fail "stock fastbootd returned an invalid COW size: $partition"
    ((reported_size == expected_size)) ||
      fail "stale COW partition size changed: $partition"
  done

  for specification in "${specifications[@]}"; do
    partition="${specification%%:*}"
    run_fastboot delete-logical-partition "$partition"
  done

  for specification in "${specifications[@]}"; do
    partition="${specification%%:*}"
    [[ "$(fastboot_variable "is-logical:$partition" || true)" != yes ]] ||
      fail "stale COW partition still exists after deletion: $partition"
  done
}

write_started=false
report_interrupted_write() {
  local status="$?"

  if [[ "$write_started" == true ]]; then
    echo "A partition write was interrupted." >&2
    echo "Keep the phone in its current USB mode and run the restore action." >&2
  fi
  exit "$status"
}
trap report_interrupted_write ERR

ensure_bootloader
write_started=true
stage_stock_fastbootd_boot_chain
reboot_bootloader_to_fastbootd
# The MTK fastbootd endpoint can enumerate before its sparse-image reader is
# ready. The first hardware attempt resized system successfully but rejected
# its first data chunk; an immediate stock restore worked after settling.
sleep 5
verify_fastbootd
if [[ "$cleanup_stale_cow" == true ]]; then
  cleanup_audited_stale_cow_partitions
fi

if [[ "$action" == install ]]; then
  for partition in system system_ext product; do
    flash_partition \
      fastbootd \
      "$(fastbootd_partition_name "$partition")" \
      "$lineage_directory/$partition.img"
  done

  reboot_fastbootd_to_bootloader
  for partition in vbmeta_system vbmeta_vendor vbmeta; do
    flash_partition \
      fastboot \
      "${partition}_a" \
      "$lineage_directory/$partition.img"
  done
  flash_partition fastboot boot_a "$lineage_directory/boot.img"
  write_started=false
  if [[ "$stay_bootloader" == true ]]; then
    verify_bootloader_identity
    ensure_bootloader_slot_a
  else
    run_fastboot reboot
  fi

  echo "Audited Lineage userspace written to slot A."
  echo "No OPlus logical partition, vendor, odm or dtbo image was written."
  if [[ "$cleanup_stale_cow" == true ]]; then
    echo "The single audited stale stock COW set was removed after status none."
  fi
  if [[ "$stay_bootloader" == true ]]; then
    echo "Phone remains in bootloader-fastboot for the next audited step."
  else
    echo "Runtime boot verification is still required."
  fi
else
  # The add-on-capable Lineage product image reserves most of the standard
  # partition headroom. Shrink it to stock first so the larger stock
  # system_ext image can be restored without a transient group overcommit.
  for partition in product system system_ext vendor odm; do
    flash_partition \
      fastbootd \
      "$(fastbootd_partition_name "$partition")" \
      "$restore_directory/images/$partition.img"
  done

  reboot_fastbootd_to_bootloader
  for partition in vbmeta_system vbmeta_vendor vbmeta; do
    flash_partition \
      fastboot \
      "${partition}_a" \
      "$restore_directory/images/$partition.img"
  done
  flash_partition fastboot boot_a "$restore_directory/images/boot.img"
  write_started=false
  run_fastboot reboot

  echo "Exact .3001 logical userspace, boot and AVB metadata restored to slot A."
  echo "No OPlus logical partition or dtbo image was written."
fi
