#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

set -euo pipefail
umask 077

usage() {
  cat >&2 <<'EOF'
usage: nord2t-lineage-root-full IMAGE_DIR --persist
       [--allow-embedded-adb-key] [--yes]
       [--vector-module FILE --vector-module-sha256 SHA256]
       [--denylist PACKAGE[:PROCESS]]...

Ensure minimal Magisk root on the audited enforcing Lineage boot in IMAGE_DIR,
then install the pinned Vector, Shamiko, Hide My Applist and AdAway stack.
Zygisk is enabled and Magisk denylist enforcement is disabled as required by
Shamiko. No app is hidden by default; repeat --denylist for explicit targets.

This full profile intentionally changes runtime observations. Prefer
nord2t-lineage-root without this profile for ROM and hardware debugging.
EOF
}

fail() {
  echo "lineage-root-full failed: $*" >&2
  exit 1
}

if [[ $# -eq 1 && ("$1" == -h || "$1" == --help) ]]; then
  usage
  exit 0
fi

[[ $# -ge 1 ]] || {
  usage
  exit 2
}

image_directory="$(realpath "$1")"
shift
persist=false
allow_embedded_adb_key=false
assume_yes=false
denylist_targets=()
vector_module_override=
vector_module_hash_override=

while [[ $# -gt 0 ]]; do
  case "$1" in
    --persist)
      persist=true
      shift
      ;;
    --allow-embedded-adb-key)
      allow_embedded_adb_key=true
      shift
      ;;
    --yes)
      assume_yes=true
      shift
      ;;
    --vector-module)
      [[ $# -ge 2 ]] || {
        usage
        exit 2
      }
      vector_module_override="$2"
      shift 2
      ;;
    --vector-module-sha256)
      [[ $# -ge 2 ]] || {
        usage
        exit 2
      }
      [[ "$2" =~ ^[0-9a-f]{64}$ ]] ||
        fail "invalid Vector module SHA-256"
      vector_module_hash_override="$2"
      shift 2
      ;;
    --denylist)
      [[ $# -ge 2 ]] || {
        usage
        exit 2
      }
      [[ "$2" =~ ^[A-Za-z0-9_.]+(:[A-Za-z0-9_.]+)?$ ]] ||
        fail "invalid denylist target: $2"
      denylist_targets+=("$2")
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
  esac
done

[[ "$persist" == true ]] || {
  usage
  fail "--persist is required because root modules and settings persist"
}
[[ -d "$image_directory" ]] ||
  fail "Lineage image directory is not readable"

vector_module="@VECTOR_MODULE@"
vector_module_size=8432605
vector_module_hash=b66605a0cf2cdbac9ca9accc9e47edc203791d3374d59fed2fa11f5a654f8333
adaway_apk="@ADAWAY_APK@"
hma_apk="@HMA_APK@"
shamiko_module="@SHAMIKO_MODULE@"

if [[ -n "$vector_module_override" ||
  -n "$vector_module_hash_override" ]]; then
  [[ -n "$vector_module_override" &&
    -n "$vector_module_hash_override" ]] ||
    fail "--vector-module and --vector-module-sha256 must be supplied together"
  vector_module="$(realpath "$vector_module_override")"
  vector_module_size="$(stat -Lc %s "$vector_module")"
  vector_module_hash="$vector_module_hash_override"
fi

verify_file() {
  local file="$1"
  local expected_size="$2"
  local expected_hash="$3"
  local label="$4"

  [[ -r "$file" && -f "$file" ]] ||
    fail "$label is not a readable regular file"
  [[ "$(stat -Lc %s "$file")" == "$expected_size" ]] ||
    fail "$label size does not match its pin"
  [[ "$(sha256sum "$file" | cut -d' ' -f1)" == "$expected_hash" ]] ||
    fail "$label SHA-256 does not match its pin"
}

verify_file \
  "$vector_module" \
  "$vector_module_size" \
  "$vector_module_hash" \
  "Vector module"
verify_file \
  "$adaway_apk" \
  13955875 \
  09f8e1528a53e5ffad59e57a174e90d4e10c5092bf4f6a60ab6594f046614417 \
  "AdAway APK"
verify_file \
  "$hma_apk" \
  3591847 \
  0adaa6bcdf7ee1e9e1c310f33b86f2f4d03f8839a10be8384e34d6cb5bd99c39 \
  "Hide My Applist APK"
verify_file \
  "$shamiko_module" \
  6523936 \
  308d31b2f52a80e49eb58f46bc4c764a6588a79e4b8d101b44860832023f88b4 \
  "Shamiko module"

audit_arguments=()
root_arguments=()
if [[ "$allow_embedded_adb_key" == true ]]; then
  audit_arguments+=(--allow-embedded-adb-key)
  root_arguments+=(--allow-embedded-adb-key)
fi
nord2t-audit-lineage-images \
  "${audit_arguments[@]}" \
  "$image_directory" \
  >/dev/null ||
  fail "source Lineage bundle did not pass its enforcing image audit"
source_system_fingerprint="$(
  nord2t-read-lineage-system-fingerprint "$image_directory/system.img"
)"
[[ -n "$source_system_fingerprint" ]] ||
  fail "source Lineage system image has no build fingerprint"

mapfile -t adb_devices < <(
  adb devices |
    awk 'NR > 1 && $2 == "device" { print $1 }'
)
[[ "${#adb_devices[@]}" -eq 1 ]] ||
  fail "expected exactly one authorized ADB device"
adb_serial="${adb_devices[0]}"

adb_property() {
  adb -s "$adb_serial" shell getprop "$1" 2>/dev/null |
    tr -d '\r'
}

wait_for_android() {
  for _ in $(seq 1 180); do
    if [[ "$(adb -s "$adb_serial" get-state 2>/dev/null || true)" == device ]] &&
      [[ "$(adb_property sys.boot_completed 2>/dev/null || true)" == 1 ]]; then
      return
    fi
    sleep 1
  done
  fail "Android did not finish booting within 180 seconds"
}

has_root() {
  adb -s "$adb_serial" shell su -c id 2>/dev/null |
    tr -d '\r' |
    grep -Fq "uid=0(root)"
}

[[ "$(adb_property sys.boot_completed)" == 1 ]] ||
  fail "Android has not finished booting"
[[ "$(adb_property ro.product.model)" == CPH2399 ]] ||
  fail "connected model is not CPH2399"
[[ "$(adb_property ro.product.device)" == OP557AL1 ]] ||
  fail "connected device is not OP557AL1"
[[ -n "$(adb_property ro.lineage.version)" ]] ||
  fail "running system is not LineageOS"
[[ "$(adb_property ro.system.build.fingerprint)" == "$source_system_fingerprint" ]] ||
  fail "running Lineage system does not match the audited image bundle"
[[ "$(adb_property ro.boot.slot_suffix)" == _a ]] ||
  fail "the audited Lineage slot A is not active"
[[ "$(adb_property ro.boot.flash.locked)" == 0 ]] ||
  fail "bootloader is not unlocked"
[[ "$(adb_property ro.boot.verifiedbootstate)" == orange ]] ||
  fail "verified boot does not report the expected unlocked state"
[[ "$(adb -s "$adb_serial" shell getenforce 2>/dev/null | tr -d '\r')" == Enforcing ]] ||
  fail "running Lineage system is not SELinux enforcing"
[[ "$(adb_property ro.crypto.state)" == encrypted &&
  "$(adb_property ro.crypto.type)" == file ]] ||
  fail "running Lineage storage is not file-based encrypted"

if [[ "$assume_yes" != true ]]; then
  printf '%s' \
    "Install the persistent full Lineage root stack and reboot? Type CPH2399-lineage-full: " \
    >&2
  read -r confirmation
  [[ "$confirmation" == CPH2399-lineage-full ]] ||
    fail "confirmation declined"
fi

host_work="$(mktemp -d -t nord2t-lineage-root-full.XXXXXXXX)"
remote_work="/data/local/tmp/nord2t-lineage-root-full-$$"
remote_exists=false

cleanup() {
  if [[ "$remote_exists" == true ]]; then
    adb -s "$adb_serial" shell "rm -rf '$remote_work'" >/dev/null 2>&1 || true
  fi
  rm -rf -- "$host_work"
}
trap cleanup EXIT

if ! has_root; then
  nord2t-lineage-root \
    "$image_directory" \
    "${root_arguments[@]}" \
    --persist \
    --yes \
    --output "$host_work/magisk-patched.img"
  wait_for_android
  if ! has_root; then
    fail "Magisk booted but Shell root is not approved; approve it in Magisk, then rerun"
  fi
fi

magisk_version="$(
  adb -s "$adb_serial" shell su -c "magisk -v" |
    tr -d '\r'
)"
[[ "$magisk_version" == 30.7:* ]] ||
  fail "running Magisk is not the pinned v30.7 baseline"

adb -s "$adb_serial" install --user 0 -r "$adaway_apk" >/dev/null
adb -s "$adb_serial" install --user 0 -r "$hma_apk" >/dev/null

adb -s "$adb_serial" shell "mkdir '$remote_work'"
remote_exists=true
adb -s "$adb_serial" push "$vector_module" "$remote_work/vector.zip" >/dev/null
adb -s "$adb_serial" push "$shamiko_module" "$remote_work/shamiko.zip" >/dev/null

adb -s "$adb_serial" shell \
  "su -c 'magisk --sqlite \"REPLACE INTO settings (key,value) VALUES (\\\"zygisk\\\",1);\"'"
adb -s "$adb_serial" shell su -c "magisk --denylist disable"

for target in "${denylist_targets[@]}"; do
  package="${target%%:*}"
  if [[ "$target" == *:* ]]; then
    adb -s "$adb_serial" shell su -c \
      "magisk --denylist add $package $target"
  else
    adb -s "$adb_serial" shell su -c \
      "magisk --denylist add $package"
  fi
done

adb -s "$adb_serial" shell \
  "su -c 'magisk --install-module $remote_work/vector.zip'"
adb -s "$adb_serial" shell \
  "su -c 'magisk --install-module $remote_work/shamiko.zip'"

adb -s "$adb_serial" shell "su -c '
  if [[ ! -d /data/adb/modules/hosts ]]; then
    mkdir -p /data/adb/modules/hosts/system/etc
    cp /system/etc/hosts /data/adb/modules/hosts/system/etc/hosts
    chmod 0755 /data/adb/modules/hosts /data/adb/modules/hosts/system
    chmod 0755 /data/adb/modules/hosts/system/etc
    chmod 0644 /data/adb/modules/hosts/system/etc/hosts
    printf \"id=hosts\\nname=Systemless Hosts\\nversion=1.0\\nversionCode=1\\nauthor=Magisk\\ndescription=Magisk app built-in systemless hosts module\\n\" \
      >/data/adb/modules/hosts/module.prop
    chmod 0644 /data/adb/modules/hosts/module.prop
    touch /data/adb/modules/hosts/update
  fi
'"

adb -s "$adb_serial" shell "rm -rf '$remote_work'"
remote_exists=false
adb -s "$adb_serial" reboot
wait_for_android

has_root ||
  fail "Android returned without approved Magisk root"
[[ "$(adb -s "$adb_serial" shell getenforce 2>/dev/null | tr -d '\r')" == Enforcing ]] ||
  fail "full rooted Lineage did not return with SELinux enforcing"

for package in org.adaway com.tsng.hidemyapplist; do
  adb -s "$adb_serial" shell pm path "$package" |
    grep -Fq "package:" ||
    fail "expected Android package is missing after reboot: $package"
done

for module in zygisk_vector zygisk_shamiko hosts; do
  adb -s "$adb_serial" shell \
    "su -c 'test -d /data/adb/modules/$module && test ! -e /data/adb/modules/$module/disable'" ||
    fail "expected active Magisk module is missing: $module"
done

zygisk_setting="$(
  adb -s "$adb_serial" shell \
    "su -c 'magisk --sqlite \"SELECT value FROM settings WHERE key=\\\"zygisk\\\";\"'" |
    tr -d '\r'
)"
grep -Fq "value=1" <<<"$zygisk_setting" ||
  fail "Magisk reports Zygisk disabled after reboot"

if adb -s "$adb_serial" shell su -c "magisk --denylist status" >/dev/null 2>&1; then
  fail "Magisk denylist enforcement is enabled, which conflicts with Shamiko"
fi

echo "Pinned full Lineage root stack installed and verified."
echo "Vector v2.0 and Shamiko v1.2.5 are active with Zygisk."
echo "Hide My Applist v3.8 and AdAway v6.1.4 are installed."
