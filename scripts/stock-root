#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: nord2t-stock-root [--output FILE] [--boot | --persist] [--yes]

Patch the pinned CPH2399 .3001 stock boot image with the pinned Magisk v30.7
APK. By default only write the patched image. --boot temporarily boots it from
RAM; --persist flashes it to the currently active boot slot. --yes skips only
the interactive confirmation required by --persist.
EOF
}

fail() {
  echo "stock-root failed: $*" >&2
  exit 1
}

mode="patch"
assume_yes=false
output="$PWD/magisk-patched-CPH2399-3001-v30.7.img"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output)
      [[ $# -ge 2 ]] || {
        usage
        exit 2
      }
      output="$2"
      shift 2
      ;;
    --boot)
      [[ "$mode" == patch ]] || fail "--boot and --persist are mutually exclusive"
      mode=boot
      shift
      ;;
    --persist)
      [[ "$mode" == patch ]] || fail "--boot and --persist are mutually exclusive"
      mode=persist
      shift
      ;;
    --yes)
      assume_yes=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
  esac
done

magisk_apk="@MAGISK_APK@"
stock_boot="@STOCK_BOOT@"
expected_apk_hash=e0d32d2123532860f97123d927b1bb86c4e08e6fd8a48bfc6b5bee0afae9ebd5
expected_apk_size=11613864
expected_boot_hash=7ad447405db4e74276395123c8029c67c63adc3fc6d82c4c180ae6c2e31882c0
expected_boot_size=67108864

verify_file() {
  local file="$1"
  local expected_size="$2"
  local expected_hash="$3"
  local label="$4"

  [[ -r "$file" && -f "$file" ]] || fail "$label is not a readable regular file"
  [[ "$(stat -Lc %s "$file")" == "$expected_size" ]] ||
    fail "$label size does not match its pin"
  [[ "$(sha256sum "$file" | cut -d' ' -f1)" == "$expected_hash" ]] ||
    fail "$label SHA-256 does not match its pin"
}

adb_property() {
  adb -s "$serial" shell getprop "$1" | tr -d '\r'
}

wait_for_fastboot() {
  for _ in $(seq 1 60); do
    if fastboot -s "$serial" devices | grep -Fq "$serial"; then
      return
    fi
    sleep 1
  done
  fail "device did not enumerate in fastboot within 60 seconds"
}

fastboot_variable() {
  local variable="$1"
  fastboot -s "$serial" getvar "$variable" 2>&1 |
    sed -nE "s/.*${variable}: ([^[:space:]]+).*/\\1/p" |
    head -n 1
}

enter_bootloader_fastboot() {
  adb -s "$serial" reboot fastboot
  wait_for_fastboot
  [[ "$(fastboot_variable is-userspace)" == yes ]] ||
    fail "expected fastbootd before entering bootloader-fastboot"

  fastboot -s "$serial" reboot bootloader
  wait_for_fastboot
  [[ "$(fastboot_variable is-userspace)" == no ]] ||
    fail "device is not in bootloader-fastboot"
  [[ "$(fastboot_variable unlocked)" == yes ]] ||
    fail "bootloader is not unlocked"
}

wait_for_android() {
  for _ in $(seq 1 180); do
    if [[ "$(adb -s "$serial" get-state 2>/dev/null || true)" == device ]] &&
      [[ "$(adb_property sys.boot_completed 2>/dev/null || true)" == 1 ]]; then
      return
    fi
    sleep 1
  done
  fail "Android did not finish booting within 180 seconds"
}

verify_file "$magisk_apk" "$expected_apk_size" "$expected_apk_hash" "Magisk APK"
verify_file "$stock_boot" "$expected_boot_size" "$expected_boot_hash" "stock boot image"

[[ ! -e "$output" ]] || fail "refusing to overwrite output: $output"
mkdir -p "$(dirname "$output")"

mapfile -t adb_devices < <(adb devices | awk 'NR > 1 && $2 == "device" { print $1 }')
[[ "${#adb_devices[@]}" == 1 ]] ||
  fail "expected exactly one authorized ADB device"
serial="${adb_devices[0]}"

[[ "$(adb_property sys.boot_completed)" == 1 ]] ||
  fail "Android has not finished booting"
[[ "$(adb_property ro.product.model)" == CPH2399 ]] ||
  fail "connected model is not CPH2399"
[[ "$(adb_property ro.product.device)" == OP557AL1 ]] ||
  fail "connected device is not OP557AL1"
[[ "$(adb_property ro.build.display.id)" == "CPH2399_14.0.0.3001(EX01)" ]] ||
  fail "installed build is not the pinned .3001 baseline"

if [[ "$mode" != patch ]]; then
  [[ "$(adb_property ro.boot.flash.locked)" == 0 ]] ||
    fail "bootloader is not unlocked"
fi

host_work="$(mktemp -d -t nord2t-stock-root.XXXXXXXX)"
remote_work="/data/local/tmp/nord2t-magisk-30700-$$"
remote_exists=false

cleanup() {
  if [[ "$remote_exists" == true ]]; then
    adb -s "$serial" shell "rm -rf '$remote_work'" >/dev/null 2>&1 || true
  fi
  rm -rf -- "$host_work"
}
trap cleanup EXIT

mkdir -p "$host_work/payload"
unzip -p "$magisk_apk" assets/boot_patch.sh >"$host_work/payload/boot_patch.sh"
unzip -p "$magisk_apk" assets/util_functions.sh >"$host_work/payload/util_functions.sh"
unzip -p "$magisk_apk" assets/stub.apk >"$host_work/payload/stub.apk"
unzip -p "$magisk_apk" lib/arm64-v8a/libbusybox.so >"$host_work/payload/busybox"
unzip -p "$magisk_apk" lib/arm64-v8a/libinit-ld.so >"$host_work/payload/init-ld"
unzip -p "$magisk_apk" lib/arm64-v8a/libmagisk.so >"$host_work/payload/magisk"
unzip -p "$magisk_apk" lib/arm64-v8a/libmagiskboot.so >"$host_work/payload/magiskboot"
unzip -p "$magisk_apk" lib/arm64-v8a/libmagiskinit.so >"$host_work/payload/magiskinit"
install -m 0644 "$stock_boot" "$host_work/payload/stock-boot.img"

adb -s "$serial" install -r "$magisk_apk" >/dev/null
adb -s "$serial" shell "mkdir '$remote_work'"
remote_exists=true
adb -s "$serial" push "$host_work/payload/." "$remote_work/" >/dev/null
adb -s "$serial" shell "
  cd '$remote_work' &&
  chmod 0755 boot_patch.sh util_functions.sh busybox init-ld magisk magiskboot magiskinit &&
  BOOTMODE=true \
  KEEPVERITY=true \
  KEEPFORCEENCRYPT=true \
  PATCHVBMETAFLAG=false \
  RECOVERYMODE=false \
  LEGACYSAR=false \
  ./busybox sh ./boot_patch.sh ./stock-boot.img
"
adb -s "$serial" pull "$remote_work/new-boot.img" "$output" >/dev/null

[[ -r "$output" && -f "$output" ]] ||
  fail "patched boot image is not a readable regular file"
[[ "$(stat -c %s "$output")" == "$expected_boot_size" ]] ||
  fail "patched boot image does not fill the 64 MiB boot partition"
patched_hash="$(sha256sum "$output" | cut -d' ' -f1)"
[[ "$patched_hash" != "$expected_boot_hash" ]] ||
  fail "Magisk output is byte-identical to stock"

mkdir -p "$host_work/stock-unpack" "$host_work/patched-unpack"
unpackbootimg -i "$stock_boot" -o "$host_work/stock-unpack" >/dev/null
unpackbootimg -i "$output" -o "$host_work/patched-unpack" >/dev/null
stock_prefix="$host_work/stock-unpack/$(basename "$stock_boot")"
patched_prefix="$host_work/patched-unpack/$(basename "$output")"

for field in \
  base board cmdline dtb dtb_offset hashtype header_version kernel \
  kernel_offset pagesize ramdisk_offset second_offset tags_offset; do
  [[ -f "$stock_prefix-$field" && -f "$patched_prefix-$field" ]] ||
    fail "unpacked image is missing $field"
  cmp -s "$stock_prefix-$field" "$patched_prefix-$field" ||
    fail "Magisk unexpectedly changed stock boot field: $field"
done

cmp -s "$stock_prefix-ramdisk" "$patched_prefix-ramdisk" &&
  fail "Magisk did not change the stock ramdisk"

echo "Verified Magisk-patched image written: $output"
echo "image_sha256=$patched_hash"

if [[ "$mode" == patch ]]; then
  exit 0
fi

adb -s "$serial" shell "rm -rf '$remote_work'"
remote_exists=false

enter_bootloader_fastboot
current_slot="$(fastboot_variable current-slot)"
[[ "$current_slot" == a || "$current_slot" == b ]] ||
  fail "unexpected active slot: $current_slot"

if [[ "$mode" == boot ]]; then
  set +e
  boot_output="$(fastboot -s "$serial" boot "$output" 2>&1)"
  boot_status=$?
  set -e
  printf '%s\n' "$boot_output"
  if [[ "$boot_status" -ne 0 ]] &&
    ! grep -Fq "Status read failed" <<<"$boot_output"; then
    fail "temporary boot command failed"
  fi
else
  if [[ "$assume_yes" != true ]]; then
    printf 'Permanently flash Magisk boot to boot_%s? Type CPH2399: ' "$current_slot" >&2
    read -r confirmation
    [[ "$confirmation" == CPH2399 ]] || fail "confirmation declined"
  fi
  fastboot -s "$serial" flash "boot_$current_slot" "$output"
  fastboot -s "$serial" reboot
fi

wait_for_android
echo "Android is up. Confirm the Magisk prompt, then verify root with:"
echo "  adb -s $serial shell su -c id"
