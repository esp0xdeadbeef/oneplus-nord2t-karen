#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: nord2t-audit-boot [--allow-insecure-adb]
                         [--allow-embedded-adb-key]
                         [--allow-permissive-selinux]
                         CANDIDATE_BOOT_IMG [STOCK_BOOT_IMG]

Audit a Karen recovery-as-boot image against the pinned CPH2399 .3001 stock
boot image. When STOCK_BOOT_IMG is omitted, the verified image is extracted
from the flake's pinned official OTA. Insecure ADB is rejected unless the
explicit flag is supplied for a temporary, unlocked bring-up image. An
embedded public ADB host key is independently rejected unless its explicit
bring-up flag is supplied. A permissive SELinux kernel command line is
independently rejected unless its private diagnostic flag is supplied.
EOF
}

fail() {
  echo "boot audit failed: $*" >&2
  exit 1
}

allow_insecure_adb=false
allow_embedded_adb_key=false
allow_permissive_selinux=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --allow-insecure-adb)
      allow_insecure_adb=true
      shift
      ;;
    --allow-embedded-adb-key)
      allow_embedded_adb_key=true
      shift
      ;;
    --allow-permissive-selinux)
      allow_permissive_selinux=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      usage
      fail "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 || $# -gt 2 ]]; then
  usage
  exit 2
fi

candidate_image="$1"
stock_image="${2:-}"

[[ -r "$candidate_image" ]] || fail "candidate is not readable: $candidate_image"
[[ -f "$candidate_image" ]] || fail "candidate is not a regular file: $candidate_image"

temporary_directory="$(mktemp -d -t nord2t-boot-audit.XXXXXXXX)"
cleanup() {
  chmod -R u+rwX -- "$temporary_directory" 2>/dev/null || true
  rm -rf -- "$temporary_directory"
}
trap cleanup EXIT

if [[ -z "$stock_image" ]]; then
  stock_directory="$temporary_directory/verified-stock"
  nord2t-extract-stock --profile boot --output "$stock_directory"
  stock_image="$stock_directory/images/boot.img"
fi

[[ -r "$stock_image" ]] || fail "stock image is not readable: $stock_image"
[[ -f "$stock_image" ]] || fail "stock image is not a regular file: $stock_image"

candidate_directory="$temporary_directory/candidate"
stock_directory="$temporary_directory/stock"
candidate_ramdisk_directory="$temporary_directory/candidate-ramdisk"
mkdir -p \
  "$candidate_directory" \
  "$stock_directory" \
  "$candidate_ramdisk_directory"

unpackbootimg \
  -i "$candidate_image" \
  -o "$candidate_directory" \
  >"$temporary_directory/candidate-header.txt"
unpackbootimg \
  -i "$stock_image" \
  -o "$stock_directory" \
  >"$temporary_directory/stock-header.txt"

candidate_prefix="$candidate_directory/$(basename "$candidate_image")"
stock_prefix="$stock_directory/$(basename "$stock_image")"

for suffix in \
  base \
  board \
  cmdline \
  dtb \
  dtb_offset \
  hashtype \
  header_version \
  kernel \
  kernel_offset \
  os_patch_level \
  os_version \
  pagesize \
  ramdisk \
  ramdisk_offset \
  second_offset \
  tags_offset; do
  [[ -f "$candidate_prefix-$suffix" ]] ||
    fail "candidate unpack is missing $suffix"
  [[ -f "$stock_prefix-$suffix" ]] ||
    fail "stock unpack is missing $suffix"
done

candidate_size="$(stat -c %s "$candidate_image")"
stock_size="$(stat -c %s "$stock_image")"
[[ "$candidate_size" == 67108864 ]] ||
  fail "candidate is $candidate_size bytes, expected the 64 MiB boot partition"
[[ "$stock_size" == 67108864 ]] ||
  fail "stock image is $stock_size bytes, expected 67108864"

matching_header_fields=(
  base
  board
  dtb_offset
  hashtype
  header_version
  kernel_offset
  pagesize
  ramdisk_offset
  second_offset
  tags_offset
)

for field in "${matching_header_fields[@]}"; do
  cmp -s "$candidate_prefix-$field" "$stock_prefix-$field" ||
    fail "boot header field differs from stock: $field"
done

[[ "$(<"$candidate_prefix-header_version")" == 2 ]] ||
  fail "candidate is not Android boot header v2"
[[ "$(<"$candidate_prefix-base")" == 0x40078000 ]] ||
  fail "unexpected kernel base"
[[ "$(<"$candidate_prefix-pagesize")" == 2048 ]] ||
  fail "unexpected page size"
[[ "$(<"$candidate_prefix-kernel_offset")" == 0x00008000 ]] ||
  fail "unexpected kernel offset"
[[ "$(<"$candidate_prefix-ramdisk_offset")" == 0x11088000 ]] ||
  fail "unexpected ramdisk offset"
[[ "$(<"$candidate_prefix-tags_offset")" == 0x07c08000 ]] ||
  fail "unexpected tags offset"
[[ "$(<"$candidate_prefix-dtb_offset")" == 0x07c08000 ]] ||
  fail "unexpected DTB offset"
expected_cmdline="bootopt=64S3,32N2,64N2 buildvariant=user androidboot.init_fatal_reboot_target=recovery androidboot.slot_suffix=_a"
selinux_mode="enforcing-default"
if [[ "$allow_permissive_selinux" == true ]]; then
  expected_cmdline+=" androidboot.selinux=permissive"
  selinux_mode="permissive-bringup-only"
fi
[[ "$(<"$candidate_prefix-cmdline")" == "$expected_cmdline" ]] ||
  fail "unexpected kernel command line"

cmp -s "$candidate_prefix-kernel" "$stock_prefix-kernel" ||
  fail "candidate kernel is not byte-identical to pinned stock"
cmp -s "$candidate_prefix-dtb" "$stock_prefix-dtb" ||
  fail "candidate DTB is not byte-identical to pinned stock"

avbtool info_image \
  --image "$candidate_image" \
  >"$temporary_directory/candidate-avb.txt"
avb_verify_directory="$temporary_directory/avb-verify"
mkdir -p "$avb_verify_directory"
ln -s "$(realpath "$candidate_image")" "$avb_verify_directory/boot.img"
avbtool verify_image --image "$avb_verify_directory/boot.img" >/dev/null

grep -Fq "Image size:               67108864 bytes" \
  "$temporary_directory/candidate-avb.txt" ||
  fail "AVB footer does not cover the expected boot partition size"
grep -Fq "Partition Name:        boot" \
  "$temporary_directory/candidate-avb.txt" ||
  fail "AVB footer is not for the boot partition"
grep -Fq "Hash Algorithm:        sha256" \
  "$temporary_directory/candidate-avb.txt" ||
  fail "AVB footer does not use SHA-256"

if bsdtar -tf "$candidate_prefix-ramdisk" |
  grep -Eq '(^/|(^|/)\.\.(/|$))'; then
  fail "candidate ramdisk contains an unsafe path"
fi
bsdtar -xf "$candidate_prefix-ramdisk" -C "$candidate_ramdisk_directory"

required_ramdisk_files=(
  first_stage_ramdisk/fstab.mt6893
  first_stage_ramdisk/system/bin/snapuserd
  init.recovery.mt6893.rc
  prop.default
  sepolicy
  system/bin/adbd
  system/bin/fastbootd
  system/bin/hw/android.hardware.boot-service.default_recovery
  system/bin/init
  system/bin/recovery
  system/etc/init/android.hardware.boot-service.default_recovery.rc
  system/etc/recovery.fstab
  system/etc/vintf/manifest/android.hardware.boot-service.default.xml
  vendor_file_contexts
)

for path in "${required_ramdisk_files[@]}"; do
  [[ -s "$candidate_ramdisk_directory/$path" ]] ||
    fail "candidate ramdisk is missing $path"
done

properties="$candidate_ramdisk_directory/prop.default"
fstab="$candidate_ramdisk_directory/system/etc/recovery.fstab"
boot_control_rc="$candidate_ramdisk_directory/system/etc/init/android.hardware.boot-service.default_recovery.rc"
boot_control_manifest="$candidate_ramdisk_directory/system/etc/vintf/manifest/android.hardware.boot-service.default.xml"
device_recovery_rc="$candidate_ramdisk_directory/init.recovery.mt6893.rc"
vendor_file_contexts="$candidate_ramdisk_directory/vendor_file_contexts"

grep -Fxq "ro.product.system.device=karen" "$properties" ||
  fail "ramdisk product device is not karen"
if grep -Fxq "ro.recovery.ui.blank_unblank_on_init=true" "$properties"; then
  fail "ramdisk enables the OLED-breaking recovery init power-cycle"
fi
grep -Fxq "ro.secure=1" "$properties" ||
  fail "ramdisk does not enable secure mode"
grep -Fq "interface aidl android.hardware.boot.IBootControl/default" \
  "$boot_control_rc" ||
  fail "recovery boot-control service does not publish the AIDL interface"
grep -Fq "<fqname>IBootControl/default</fqname>" "$boot_control_manifest" ||
  fail "recovery boot-control VINTF fragment lacks the default interface"
grep -Eq \
  '^/dev/block/sdc1[[:space:]]+u:object_r:misc_block_device:s0$' \
  "$vendor_file_contexts" ||
  fail "recovery does not label the concrete misc block device"
grep -Eq \
  '^/dev/block/sdc68[[:space:]]+u:object_r:super_block_device:s0$' \
  "$vendor_file_contexts" ||
  fail "recovery does not label the concrete super block device"
grep -Fq "restorecon /dev/block/sdc68" "$device_recovery_rc" ||
  fail "recovery does not apply the concrete super block label before fastbootd"
boot_label_action="$(
  awk '
    /^on boot$/ {
      in_boot_action = 1
      next
    }
    /^on / {
      in_boot_action = 0
    }
    in_boot_action
  ' "$device_recovery_rc"
)"
grep -Fq "restorecon /dev/block/sdc1" <<<"$boot_label_action" ||
  fail "recovery does not refresh the concrete misc block label before starting services"
grep -Fq "restorecon /dev/block/sdc68" <<<"$boot_label_action" ||
  fail "recovery does not refresh the concrete super block label before starting services"
fastboot_label_action="$(
  awk '
    /^on property:sys\.usb\.config=fastboot$/ {
      in_fastboot_action = 1
      next
    }
    /^on / {
      in_fastboot_action = 0
    }
    in_fastboot_action
  ' "$device_recovery_rc"
)"
grep -Fq "restorecon /dev/block/sdc1" <<<"$fastboot_label_action" ||
  fail "recovery does not refresh the concrete misc block label for fastbootd"
grep -Fq "restorecon /dev/block/sdc68" <<<"$fastboot_label_action" ||
  fail "recovery does not refresh the concrete super block label for fastbootd"

if grep -Fxq "ro.adb.secure=1" "$properties"; then
  adb_security="authenticated"
elif grep -Fxq "ro.adb.secure=0" "$properties"; then
  [[ "$allow_insecure_adb" == true ]] ||
    fail "ramdisk disables ADB authentication; use --allow-insecure-adb only for a temporary bring-up image"
  adb_security="insecure-bringup-only"
else
  fail "ramdisk has no recognized ro.adb.secure setting"
fi

embedded_adb_keys="$candidate_ramdisk_directory/adb_keys"
if [[ -e "$embedded_adb_keys" ]]; then
  [[ "$allow_embedded_adb_key" == true ]] ||
    fail "candidate ramdisk embeds an ADB host key; use --allow-embedded-adb-key only for local bring-up"
  [[ "$adb_security" == authenticated ]] ||
    fail "an embedded host key cannot compensate for disabled ADB authentication"
  [[ -f "$embedded_adb_keys" && -s "$embedded_adb_keys" ]] ||
    fail "embedded ADB host key is not a non-empty regular file"
  [[ "$(awk 'NF { count++ } END { print count + 0 }' "$embedded_adb_keys")" == 1 ]] ||
    fail "embedded ADB key file must contain exactly one public key"
  adb_key_material="$(awk 'NF { print $1; exit }' "$embedded_adb_keys")"
  printf '%s' "$adb_key_material" |
    base64 --decode >"$temporary_directory/embedded-adb-key.bin" 2>/dev/null ||
    fail "embedded ADB key is not valid base64"
  [[ "$(stat -c %s "$temporary_directory/embedded-adb-key.bin")" == 524 ]] ||
    fail "embedded ADB key is not an Android RSA public key"
  adb_security="authenticated-embedded-host-key"
fi

grep -Fq "/dev/block/by-name/userdata /data f2fs" "$fstab" ||
  fail "ramdisk lacks the current userdata mapping"
grep -Fq "fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized" \
  "$fstab" ||
  fail "ramdisk userdata encryption options do not match stock"
grep -Fq "/dev/block/by-name/metadata /metadata ext4" "$fstab" ||
  fail "ramdisk lacks the metadata mapping"
grep -Fq "system /system erofs" "$fstab" ||
  fail "ramdisk lacks the EROFS system mapping"

if grep -Eq \
  '/dev/block/by-name/(frp|nvcfg|nvdata|nvram|persist|proinfo|protect1|protect2|seccfg)([[:space:]]|$)' \
  "$fstab"; then
  fail "ramdisk exposes a device-unique or security partition"
fi

candidate_hash="$(sha256sum "$candidate_image" | cut -d' ' -f1)"
kernel_hash="$(sha256sum "$candidate_prefix-kernel" | cut -d' ' -f1)"
dtb_hash="$(sha256sum "$candidate_prefix-dtb" | cut -d' ' -f1)"
avb_algorithm="$(
  awk -F: '/^Algorithm:/ {
    sub(/^[[:space:]]+/, "", $2)
    print $2
    exit
  }' "$temporary_directory/candidate-avb.txt"
)"

echo "Karen recovery-as-boot audit passed."
echo "image_sha256=$candidate_hash"
echo "image_size=$candidate_size"
echo "kernel_sha256=$kernel_hash"
echo "dtb_sha256=$dtb_hash"
echo "header_version=$(<"$candidate_prefix-header_version")"
echo "os_version=$(<"$candidate_prefix-os_version")"
echo "os_patch_level=$(<"$candidate_prefix-os_patch_level")"
echo "stock_os_patch_level=$(<"$stock_prefix-os_patch_level")"
echo "avb_algorithm=$avb_algorithm"
echo "adb_security=$adb_security"
echo "selinux_mode=$selinux_mode"

if [[ "$avb_algorithm" == NONE ]]; then
  echo "flash_gate=unsigned-test-image-requires-unlocked-bootloader"
else
  echo "flash_gate=verify-signing-key-before-use"
fi
