#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: nord2t-audit-lineage-images [--allow-embedded-adb-key]
                                   [--allow-permissive-selinux]
                                   [--expected-kernel-sha256 SHA256]
                                   IMAGE_DIR

Audit a complete Karen full-userspace image directory before any hardware
write. The directory must contain boot, system, system_ext, product, vendor,
odm, vbmeta, vbmeta_system and vbmeta_vendor images. An embedded public ADB
host key is rejected unless explicitly allowed for a private bring-up bundle.
A permissive SELinux command line is independently rejected unless explicitly
allowed for a private diagnostic bundle.
EOF
}

fail() {
  echo "Lineage image audit failed: $*" >&2
  exit 1
}

allow_embedded_adb_key=false
allow_permissive_selinux=false
expected_kernel_sha256=
while [[ $# -gt 0 ]]; do
  case "$1" in
    --allow-embedded-adb-key)
      allow_embedded_adb_key=true
      shift
      ;;
    --allow-permissive-selinux)
      allow_permissive_selinux=true
      shift
      ;;
    --expected-kernel-sha256)
      [[ $# -ge 2 ]] ||
        fail "--expected-kernel-sha256 requires a lowercase SHA-256"
      [[ "$2" =~ ^[0-9a-f]{64}$ ]] ||
        fail "--expected-kernel-sha256 requires a lowercase SHA-256"
      expected_kernel_sha256="$2"
      shift 2
      ;;
    -*)
      usage
      fail "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

image_directory="$(realpath "$1")"
partition_manifest="${PARTITION_MANIFEST:-@PARTITION_MANIFEST@}"
standard_image_ceiling=8816586752

[[ -d "$image_directory" ]] ||
  fail "image directory is not readable: $image_directory"
[[ -r "$partition_manifest" ]] ||
  fail "partition manifest is not readable: $partition_manifest"

images=(
  boot
  system
  system_ext
  product
  vendor
  odm
  vbmeta
  vbmeta_system
  vbmeta_vendor
)

for image in "${images[@]}"; do
  path="$image_directory/$image.img"
  [[ -f "$path" && -r "$path" ]] ||
    fail "required image is not readable: $image.img"
  [[ -s "$path" ]] ||
    fail "required image is empty: $image.img"
done

verify_stock_partition() {
  local partition="$1"
  local image="$2"
  local expected_size expected_hash actual_size actual_hash

  expected_size="$(
    jq -er --arg name "$partition" \
      '.partitions[] | select(.name == $name) | .size' \
      "$partition_manifest"
  )"
  expected_hash="$(
    jq -er --arg name "$partition" \
      '.partitions[] | select(.name == $name) | .sha256' \
      "$partition_manifest"
  )"
  actual_size="$(stat -c %s "$image")"
  actual_hash="$(sha256sum "$image" | cut -d ' ' -f 1)"

  [[ "$actual_size" == "$expected_size" ]] ||
    fail "$partition is $actual_size bytes, expected exact stock size $expected_size"
  [[ "$actual_hash" == "$expected_hash" ]] ||
    fail "$partition does not match the pinned stock image"
}

verify_stock_partition vendor "$image_directory/vendor.img"
verify_stock_partition odm "$image_directory/odm.img"

temporary_directory="$(mktemp -d -t nord2t-lineage-audit.XXXXXXXX)"
cleanup() {
  rm -rf -- "$temporary_directory"
}
trap cleanup EXIT

declare -A expanded_image_bytes
declare -A minimum_free_bytes=(
  [system]=33554432
  [system_ext]=67108864
  [product]=1342177280
)
declare -A filesystem_free_bytes

ext4_field() {
  local image="$1"
  local field="$2"

  tune2fs -l "$image" 2>/dev/null |
    awk -F: -v field="$field" '
      $1 == field {
        sub(/^[[:space:]]+/, "", $2)
        print $2
        exit
      }
    '
}

for partition in system system_ext product; do
  raw_image="$temporary_directory/$partition.raw.img"
  simg2img "$image_directory/$partition.img" "$raw_image" >/dev/null ||
    fail "$partition is not a valid Android sparse image"

  filesystem_magic="$(ext4_field "$raw_image" "Filesystem magic number")"
  [[ "$filesystem_magic" == "0xEF53" ]] ||
    fail "$partition is not ext4"

  block_size="$(ext4_field "$raw_image" "Block size")"
  free_blocks="$(ext4_field "$raw_image" "Free blocks")"
  [[ "$block_size" =~ ^[0-9]+$ && "$free_blocks" =~ ^[0-9]+$ ]] ||
    fail "could not determine $partition ext4 free space"

  filesystem_free_bytes["$partition"]=$((block_size * free_blocks))
  ((filesystem_free_bytes["$partition"] >= minimum_free_bytes["$partition"])) ||
    fail "$partition has only ${filesystem_free_bytes[$partition]} free bytes; expected at least ${minimum_free_bytes[$partition]} for the pinned add-on profile"

  expanded_image_bytes["$partition"]="$(stat -c %s "$raw_image")"
  ((expanded_image_bytes["$partition"] % 4096 == 0)) ||
    fail "$partition expanded image size is not 4096-byte aligned"
done

standard_image_bytes=0
for partition in system system_ext product vendor odm; do
  if [[ -n "${expanded_image_bytes[$partition]:-}" ]]; then
    size="${expanded_image_bytes[$partition]}"
  else
    size="$(stat -c %s "$image_directory/$partition.img")"
  fi
  ((size % 4096 == 0)) ||
    fail "$partition image size is not 4096-byte aligned"
  ((standard_image_bytes += size))
done

((standard_image_bytes <= standard_image_ceiling)) ||
  fail "standard images need $standard_image_bytes bytes, exceeding the preserved live budget of $standard_image_ceiling"

stock_directory="$temporary_directory/stock"
nord2t-extract-stock --profile boot --output "$stock_directory" >/dev/null
boot_audit_arguments=()
if [[ "$allow_embedded_adb_key" == true ]]; then
  boot_audit_arguments+=(--allow-embedded-adb-key)
fi
if [[ "$allow_permissive_selinux" == true ]]; then
  boot_audit_arguments+=(--allow-permissive-selinux)
fi
if [[ -n "$expected_kernel_sha256" ]]; then
  boot_audit_arguments+=(--expected-kernel-sha256 "$expected_kernel_sha256")
fi
nord2t-audit-boot \
  "${boot_audit_arguments[@]}" \
  "$image_directory/boot.img" \
  "$stock_directory/images/boot.img" \
  >"$temporary_directory/boot-audit.txt"

verify_directory="$temporary_directory/verify"
mkdir "$verify_directory"
for image in "${images[@]}"; do
  ln -s "$image_directory/$image.img" "$verify_directory/$image.img"
done
ln -s "$stock_directory/images/dtbo.img" "$verify_directory/dtbo.img"

for vbmeta in vbmeta vbmeta_system vbmeta_vendor; do
  avbtool info_image \
    --image "$verify_directory/$vbmeta.img" \
    >"$temporary_directory/$vbmeta-info.txt"
done

grep -Fq "Algorithm:                SHA256_RSA4096" \
  "$temporary_directory/vbmeta-info.txt" ||
  fail "top-level vbmeta does not use the expected bring-up algorithm"
grep -Fq "Flags:                    3" \
  "$temporary_directory/vbmeta-info.txt" ||
  fail "top-level vbmeta is not explicitly unlock-only"

for partition in vbmeta_system vbmeta_vendor; do
  grep -Fq "Partition Name:          $partition" \
    "$temporary_directory/vbmeta-info.txt" ||
    fail "top-level vbmeta does not chain $partition"
done

for partition in product system system_ext; do
  grep -Fq "Partition Name:        $partition" \
    "$temporary_directory/vbmeta_system-info.txt" ||
    fail "vbmeta_system does not describe $partition"
done

grep -Fq "Partition Name:        vendor" \
  "$temporary_directory/vbmeta_vendor-info.txt" ||
  fail "vbmeta_vendor does not describe vendor"

avbtool verify_image \
  --image "$verify_directory/vbmeta.img" \
  --follow_chain_partitions \
  >"$temporary_directory/avb-verify.txt"

echo "Karen full-userspace image audit passed."
grep -E \
  '^(image_sha256|kernel_sha256|dtb_sha256|adb_security|selinux_mode|flash_gate)=' \
  "$temporary_directory/boot-audit.txt"
for image in "${images[@]}"; do
  echo "$image.size=$(stat -c %s "$image_directory/$image.img")"
  echo "$image.sha256=$(sha256sum "$image_directory/$image.img" | cut -d ' ' -f 1)"
done
for partition in system system_ext product; do
  echo "$partition.filesystem=ext4"
  echo "$partition.expanded_size=${expanded_image_bytes[$partition]}"
  echo "$partition.free_bytes=${filesystem_free_bytes[$partition]}"
done
echo "standard_image_bytes=$standard_image_bytes"
echo "standard_image_ceiling=$standard_image_ceiling"
echo "stock_vendor=exact"
echo "stock_odm=exact"
echo "avb_chain=verified"
