# SPDX-License-Identifier: Apache-2.0

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1

on fs
    wait /dev/block/platform/bootdevice/
    symlink /dev/block/platform/bootdevice/ /dev/block/bootdevice
    # Extended-devt UFS nodes initially inherit tmpfs in this recovery. Apply
    # the narrow device file-context rules before boot-control and fastbootd
    # resolve their by-name symlinks.
    wait /dev/block/sdc1
    wait /dev/block/sdc68
    restorecon /dev/block/sdc1
    restorecon /dev/block/sdc68
    write /sys/class/power_supply/usb/otg_switch 1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

# ueventd can recreate extended-devt nodes after the fs trigger. The recovery
# init starts its default classes during the boot trigger, so refresh the labels
# in an earlier imported boot action before recovery or fastbootd can start.
on boot
    wait /dev/block/sdc1
    wait /dev/block/sdc68
    restorecon /dev/block/sdc1
    restorecon /dev/block/sdc68

# Also refresh them when recovery explicitly switches its USB mode to fastboot.
on property:sys.usb.config=fastboot
    wait /dev/block/sdc1
    wait /dev/block/sdc68
    restorecon /dev/block/sdc1
    restorecon /dev/block/sdc68
